# Kivra storage setup — pick ONE backend and fill in its vars.
# Free tiers: Supabase 1 GB · Dropbox 2 GB · Google Drive 15 GB (shared).
# Nothing uploads until you explicitly run: python scripts/storage.py upload ...

# Example: Supabase (recommended for checkpoints; easiest programmatic access)
KIVRA_STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_BUCKET=kivra-checkpoints

# Example: Dropbox
# KIVRA_STORAGE_BACKEND=dropbox
# DROPBOX_REFRESH_TOKEN=...
# DROPBOX_APP_KEY=...
# DROPBOX_APP_SECRET=...

# Example: Google Drive
# KIVRA_STORAGE_BACKEND=gdrive
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_DRIVE_FOLDER_ID=...
