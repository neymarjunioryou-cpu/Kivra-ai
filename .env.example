# Kivra environment example — copy to .env and fill in ONLY if you use cloud storage.
# Nothing is uploaded automatically.

# Optional cloud storage backends (one at a time)
KIVRA_STORAGE_BACKEND=supabase   # supabase | dropbox | gdrive | (unset = local only)

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_BUCKET=kivra-checkpoints

# Dropbox
DROPBOX_REFRESH_TOKEN=...
DROPBOX_APP_KEY=...
DROPBOX_APP_SECRET=...

# Google Drive
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_DRIVE_FOLDER_ID=...

# Hugging Face (only needed to download base checkpoints)
# HF_TOKEN=hf_...
